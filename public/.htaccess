# used.gadelog.com（静的書き出し版）をシンレンタルサーバー（Apache）で配信するための設定。
# next build の out/ にそのままコピーされる（public/ の中身）。手順は docs/static-export.md

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

# /iphone は iphone.html と iphone/（機種ページのフォルダ）の両方があるので、
# フォルダへの自動の「/」付けを止めて .html を返す（URL は今の Vercel 版と同じ・末尾の / なし）
DirectorySlash Off

RewriteEngine On

# used.gadelog.com 以外のホスト名（ブログ側のフォルダ gadelog.com/used/… など）で来たら寄せる（手元の確認用の localhost は除く）
RewriteCond %{HTTP_HOST} !^used\.gadelog\.com$ [NC]
RewriteCond %{HTTP_HOST} !^localhost
RewriteRule ^(.*)$ https://used.gadelog.com/$1 [R=301,L]

# rsync の配置途中の一時フォルダ（--delay-updates の .~tmp~）は見せない
RewriteRule (^|/)\.~tmp~ - [R=404,L]

# http → https（Vercel 版と同じく https に寄せる。SSL の認証用 .well-known は除く）
RewriteCond %{HTTPS} !on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTP_HOST} !^localhost
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 末尾に / が付いた URL は付かない形へ（トップは除く）
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# /iphone/iphone-13 → /iphone/iphone-13.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# 同じ名前の .html がないフォルダ（/compare・/data など）は、一覧を出さない設定の 403 ではなく 404 にする
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^ - [R=404,L]

# OGP 画像は拡張子なしのファイル名で書き出される
<FilesMatch "^opengraph-image$">
  ForceType image/png
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # mod_deflate が ETag の末尾に -gzip を付けると 304 が返らなくなるので、比べるときは外す（Apache 2.4 の既知の問題）
  RequestHeader edit "If-None-Match" '^"((.*)-gzip)"$' '"$1", "$2"'
  # ファイル名にハッシュが付くもの（JS・CSS）は長くキャッシュ
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # HTML・在庫データ・監視は1日4回作り直すので、毎回確認させる
  <If "%{REQUEST_URI} !~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </If>
</IfModule>
