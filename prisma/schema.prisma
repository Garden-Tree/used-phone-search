generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DeviceInventory {
  id              String   @id @default(uuid())
  // 基本情報
  manufacturer    String   // 例: Apple
  modelName       String   // 例: iPhone 13
  storage         Int      // 容量(GB) 例: 128
  color           String   // 例: ミッドナイト
  
  // 中古特有の情報
  conditionRank   String   // 例: S, A, B, C, J
  batteryHealth   Int?     // 最大容量(%) 例: 85
  networkStatus   String?  // 利用制限 例: 〇, △, -
  simUnlocked     Boolean  // SIMロック解除済みか
  carrier         String?  // 元の販売元 例: docomo, au, Apple
  memoryGB        Int?     // メモリ(GB)。MacBook だけ（storage は SSD の容量）。2026-10-15〜

  // 販売情報
  shopName        String   // 例: イオシス, じゃんぱら
  price           Int      // 価格
  url             String   // 商品URL（アフィリエイトリンク）
  isSoldOut       Boolean  @default(false) // 在庫ステータス
  // 同じ商品を別の売り場でも売っているとき（公式の行に、イオシス楽天市場店・エムコム Yahoo!ショッピング店の価格・URL を添える。scripts/link-duplicate-shops.ts）
  altPrice        Int?
  altUrl          String?

  // メタ情報
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([modelName])
  @@index([price])
  @@index([shopName])
  @@index([conditionRank])
  @@index([storage])
  @@index([batteryHealth])
  @@index([carrier])
}

// モデル別の価格推移（1日1レコード / モデル × 容量）。storage = 0 は全容量の集計
model PriceSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @db.Date // JST の日付
  modelSlug   String   // 例: iphone-15-pro
  storage     Int      // 容量(GB)。0 = 全容量
  minPrice    Int
  medianPrice Int
  count       Int
  updatedAt   DateTime @updatedAt

  @@unique([date, modelSlug, storage])
  @@index([modelSlug, storage, date])
}

// 中古パソコン（Windows のノート・デスクトップ。2026-10-27〜）。スマホとは別の表。
// 取得は scraper/qualit_scraper.py・pcwrap_scraper.py（店の一覧ページだけ・1日2回まで）、条件の読み取りは scraper/pc_spec.py
model PcInventory {
  id            String   @id @default(uuid())
  shopName      String   // 例: Qualit, PC WRAP
  formFactor    String   // note | desktop
  maker         String   // 例: Lenovo, 富士通
  productName   String   // 店の表記の機種名 例: Lenovo ThinkPad X13 Gen 1
  cpu           String   // 例: Core i5-10210U, Core Ultra 5 125U, Ryzen 5 5500U
  cpuFamily     String   // 例: Core i5, Core Ultra 5, Ryzen 5
  cpuGen        Int?     // Intel Core i の世代（Core Ultra・Ryzen は null）
  win11         Boolean  // Windows 11 の対応 CPU か（Microsoft の一覧: Intel 第8世代以降・Core Ultra・Ryzen 2000 以降）
  memoryGB      Int
  storageGB     Int
  storageType   String   // SSD | HDD
  gpu           String?  // 専用 GPU（例: RTX3060）。内蔵だけなら null
  screenInch    Float?   // ノートの画面。デスクトップは null
  conditionRank String   // S, A, B, C, J（訳あり）にそろえたもの
  rankLabel     String   // 店の表記 例: C:並品, 特選
  stock         Int?     // 店の在庫数（出ていれば）
  price         Int      // 税込
  url           String   // 商品ページ（A8 のリンクは画面で付ける。lib/affiliate.ts）
  isSoldOut     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shopName])
  @@index([formFactor, price])
  @@index([cpuFamily])
}

// 中古パソコンの相場の推移（2026-10-27〜）。1日1行 / 形（note・desktop）× CPU（系統・世代）× メモリ。訳あり品は除く。
// 記録は scripts/snapshot-pc-prices.ts（GitHub Actions で中古パソコンの取得の後）
model PcPriceSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @db.Date // JST の日付
  formFactor  String   // note | desktop
  cpuLabel    String   // 例: Core i5 第10世代, Core Ultra 5, Ryzen 5
  memoryGB    Int
  minPrice    Int
  medianPrice Int
  count       Int
  updatedAt   DateTime @updatedAt

  @@unique([date, formFactor, cpuLabel, memoryGB])
  @@index([formFactor, cpuLabel, memoryGB, date])
}

// 店の買取価格（店が客から買い取る値段・2026-10-28〜）。iPhone だけ・店ごとに週1回洗い替え（scraper/buyback_scraper.py）。
// /iphone/resale-value の「発表時の値段 − いま売るといくら」に使う。grade は店の区分のまま（ネットオフ s/a/ab/b/c・にこスマ A/B/C・モバステ unopened/used_max/used_min）
model BuybackPrice {
  id         String   @id @default(uuid())
  shopName   String   // ネットオフ / にこスマ / モバステ
  model      String   // lib/catalog.ts の機種名 例: iPhone 15 Pro Max
  storage    Int      // GB
  grade      String
  gradeLabel String   // 店の表記 例: 美品, 良品
  carrier    String?  // 店の表記（にこスマは容量ごとに1つ）
  price      Int      // 円（店の表示のまま。特典込みなど条件は店ごと）
  url        String   // 価格が載っているページ
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([model, storage])
  @@index([shopName])
}
